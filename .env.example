# CVBasedAIGymTrainer Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# Application
# =============================================================================
APP_NAME=CVBasedAIGymTrainer
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development

# API
API_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
WORKERS=1

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://*.hf.space

# =============================================================================
# Database (PostgreSQL with pgvector)
# =============================================================================
# Local: postgresql+asyncpg://trainer:password@localhost:5432/gym_trainer
# Docker: postgresql+asyncpg://trainer:trainer_password@postgres:5432/gym_trainer
DATABASE_URL=postgresql+asyncpg://trainer:trainer_password@localhost:5432/gym_trainer
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false

# =============================================================================
# Redis (Cache + Celery Broker)
# =============================================================================
# Local: redis://localhost:6379/0
# Docker: redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=20

# =============================================================================
# S3/MinIO Storage
# =============================================================================
# Local MinIO: http://localhost:9000
# Docker MinIO: http://minio:9000
# AWS S3: https://s3.us-east-1.amazonaws.com
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=gym-trainer
S3_REGION=us-east-1
S3_USE_SSL=false

# =============================================================================
# JWT Authentication
# =============================================================================
# IMPORTANT: Generate a secure random string (min 32 chars)
# openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# =============================================================================
# ML Models
# =============================================================================
MODELS_DIR=/app/models
POSE_MODEL_PATH=/app/models/pose_landmarker.onnx
POSE_MODEL_TRT_PATH=/app/models/pose_landmarker_fp16.engine
SCORER_MODEL_PATH=/app/models/form_scorer.onnx
# Options: TensorrtExecutionProvider,CUDAExecutionProvider,CPUExecutionProvider
# For CPU only: CPUExecutionProvider
ONNX_PROVIDERS=CPUExecutionProvider

# DWPose Models (for pose transfer)
DWPOSE_MODEL_PATH=/app/models/dwpose.onnx
# Options: CUDAExecutionProvider,CPUExecutionProvider
DWPOSE_ONNX_PROVIDERS=CUDAExecutionProvider,CPUExecutionProvider

# MediaPipe Pose Config
POSE_MIN_DETECTION_CONFIDENCE=0.5
POSE_MIN_TRACKING_CONFIDENCE=0.5
POSE_MODEL_COMPLEXITY=1  # 0=lite, 1=full, 2=heavy

# =============================================================================
# Video Processing
# =============================================================================
MAX_VIDEO_SIZE_MB=500
MAX_VIDEO_DURATION_SECONDS=300
SUPPORTED_VIDEO_FORMATS=.mp4,.mov,.avi,.mkv
FRAME_EXTRACTION_FPS=30
TEMP_DIR=/tmp/gym_trainer

# =============================================================================
# Celery Configuration
# =============================================================================
# Defaults to REDIS_URL if not set
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_TASK_ACKS_LATE=true
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_TASK_TIME_LIMIT=600
CELERY_TASK_SOFT_TIME_LIMIT=540

# =============================================================================
# External Services
# =============================================================================
# Get from https://modal.com - for FLUX.1-schnell image generation
MODAL_API_KEY=
MODAL_IMAGE_GEN_ENDPOINT=
# Pose Transfer specific endpoint (after deploying modal/pose_transfer.py)
MODAL_POSE_TRANSFER_ENDPOINT=

# =============================================================================
# Rate Limiting
# =============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# =============================================================================
# Monitoring
# =============================================================================
# Get from https://sentry.io
SENTRY_DSN=
LOG_LEVEL=INFO
LOG_FORMAT=json  # json or console
HEALTH_CHECK_INTERVAL=30

# =============================================================================
# Frontend (FRONTEND/.env.local)
# =============================================================================
# VITE_API_BASE_URL=http://localhost:8000