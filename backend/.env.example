# CVBasedAIGymTrainer - Backend Environment Variables
# Copy this file to .env and fill in your values
# cp .env.example .env

###############################################################################
# APP SETTINGS
###############################################################################
APP_NAME=CVBasedAIGymTrainer
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development  # development, staging, production

###############################################################################
# API SETTINGS
###############################################################################
API_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
WORKERS=1

###############################################################################
# CORS ORIGINS (comma-separated, NO wildcards for security)
###############################################################################
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

###############################################################################
# DATABASE (PostgreSQL with pgvector)
# Format: postgresql+asyncpg://user:password@host:port/database
###############################################################################
DATABASE_URL=postgresql+asyncpg://trainer:password@localhost:5432/gym_trainer
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false

###############################################################################
# REDIS (for caching, Celery broker, rate limiting)
###############################################################################
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=20

###############################################################################
# S3 / MINIO STORAGE
# For local development with docker-compose minio service
###############################################################################
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=gym-trainer
S3_REGION=us-east-1
S3_USE_SSL=false

###############################################################################
# JWT AUTHENTICATION
# CRITICAL: Generate a secure 32+ character secret for production!
# openssl rand -base64 32
###############################################################################
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

###############################################################################
# ML MODELS
# Paths inside Docker container (mounted from ./models)
###############################################################################
MODELS_DIR=/app/models
POSE_MODEL_PATH=/app/models/pose_landmarker.onnx
POSE_MODEL_TRT_PATH=/app/models/pose_landmarker_fp16.engine  # Optional TensorRT engine
SCORER_MODEL_PATH=/app/models/form_scorer.onnx

# ONNX Runtime providers (priority order)
# GPU: TensorrtExecutionProvider,CUDAExecutionProvider,CPUExecutionProvider
# CPU only: CPUExecutionProvider
ONNX_PROVIDERS=TensorrtExecutionProvider,CUDAExecutionProvider,CPUExecutionProvider

# MediaPipe Pose Configuration
POSE_MIN_DETECTION_CONFIDENCE=0.5
POSE_MIN_TRACKING_CONFIDENCE=0.5
POSE_MODEL_COMPLEXITY=1  # 0=lite, 1=full, 2=heavy

###############################################################################
# VIDEO PROCESSING
###############################################################################
MAX_VIDEO_SIZE_MB=500
MAX_VIDEO_DURATION_SECONDS=300
SUPPORTED_VIDEO_FORMATS=.mp4,.mov,.avi,.mkv
FRAME_EXTRACTION_FPS=30
TEMP_DIR=/tmp/gym_trainer

###############################################################################
# CELERY (Async task processing)
# Defaults to REDIS_URL if not set
###############################################################################
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_TASK_ACKS_LATE=true
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_TASK_TIME_LIMIT=600
CELERY_TASK_SOFT_TIME_LIMIT=540

###############################################################################
# EXTERNAL SERVICES (Optional)
# Modal.com for FLUX.1-schnell image generation
###############################################################################
MODAL_API_KEY=
MODAL_IMAGE_GEN_ENDPOINT=

###############################################################################
# RATE LIMITING
###############################################################################
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

###############################################################################
# MONITORING & OBSERVABILITY
###############################################################################
SENTRY_DSN=
LOG_LEVEL=INFO
LOG_FORMAT=json  # json or console
HEALTH_CHECK_INTERVAL=30